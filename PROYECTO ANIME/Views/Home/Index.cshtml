@{
    ViewData["Title"] = "Personajes de Dragon Ball";
}

@model Root

<h1>Personajes de Dragon Ball</h1>

@foreach (var personaje in @Model.items)
{
    <div>
        <h2>@personaje.name</h2>
        <p><strong>Raza:</strong> @personaje.race</p>
        <p><strong>Género:</strong> @personaje.gender</p>
        <p><strong>Ki:</strong> @personaje.ki / @personaje.maxKi</p>
        <p><strong>Descripción:</strong> @personaje.description</p>
        <img src="@personaje.image" alt="Imagen de @personaje.name" style="width: 200px; height: auto;" />
    </div>
}
</div>




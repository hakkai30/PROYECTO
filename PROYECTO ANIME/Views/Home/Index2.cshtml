@{
    ViewData["Title"] = "Transformaciones de Dragon Ball";
}

@model List<Root3>

<h1>Transformaciones de Dragon Ball</h1>

@foreach (var transformacion in @Model)
{
    <div class="personaje-card2">
        <h2>@transformacion.name</h2>
        <p><strong>Ki:</strong> @transformacion.ki</p>
        <img src="@transformacion.image" alt="Imagen de @transformacion.name" style="width: 200px; height: auto;" />
    </div>
}

<style>
    body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(135deg, #ff9800 0%, #1976d2 100%);
        color: #222;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }
    h1 {
        text-align: center;
        margin-top: 30px;
        color: #fff;
        text-shadow: 2px 2px 8px #000, 0 0 10px #ffeb3b;
        letter-spacing: 2px;
        font-size: 2.8em;
        font-family: 'Impact', 'Arial Black', Arial, sans-serif;
    }
    .personaje-card2 {
        border: 3px solid #ff9800;
        border-radius: 18px;
        box-shadow: 0 6px 24px 0 rgba(25, 118, 210, 0.25), 0 1.5px 4px #1976d2;
        padding: 24px 32px 24px 24px;
        margin: 32px auto;
        width: 90%;
        max-width: 600px;
        background: rgba(255,255,255,0.95);
        position: relative;
        overflow: hidden;
        transition: transform 0.2s;
    }
    .personaje-card2:hover {
        transform: scale(1.03) rotate(-1deg);
        box-shadow: 0 12px 36px 0 #ff9800aa, 0 2px 8px #1976d2;
    }
    .personaje-card2::before {
        content: '';
        position: absolute;
        top: -40px; left: -40px;
        width: 120px; height: 120px;
        background: radial-gradient(circle, #ffeb3b 0%, transparent 70%);
        opacity: 0.25;
        z-index: 0;
    }
    .personaje-card2 h2 {
        color: #1976d2;
        text-shadow: 1px 1px 0 #fff, 0 0 8px #ff9800;
        margin-bottom: 10px;
        font-size: 2em;
        font-family: 'Impact', 'Arial Black', Arial, sans-serif;
        letter-spacing: 1px;
        z-index: 1;
        position: relative;
    }
    .personaje-card2 img {
        display: block;
        margin: 18px auto 10px auto;
        border-radius: 12px;
        border: 3px solid #1976d2;
        box-shadow: 0 0 24px #ffeb3b88, 0 1px 4px #1976d2;
        width: 220px;
        background: #fff;
        z-index: 1;
        position: relative;
    }
    .personaje-card2 p {
        font-size: 1.1em;
        margin: 6px 0;
        z-index: 1;
        position: relative;
    }
    .personaje-card2 strong {
        color: #ff9800;
        font-weight: bold;
        letter-spacing: 0.5px;
        text-shadow: 0 0 4px #fff;
    }
    /* Ki bar */
    .ki-bar-container {
        background: #eee;
        border-radius: 8px;
        overflow: hidden;
        margin: 8px 0 12px 0;
        height: 18px;
        box-shadow: 0 1px 4px #1976d2;
        width: 100%;
        max-width: 320px;
    }
    .ki-bar {
        height: 100%;
        background: linear-gradient(90deg, #ffeb3b 0%, #ff9800 100%);
        box-shadow: 0 0 8px #ffeb3b, 0 0 4px #ff9800;
        transition: width 0.5s;
    }

    .affiliation-badge {
        display: inline-block;
        background: #1976d2;
        color: #fff;
        border-radius: 8px;
        padding: 2px 10px;
        font-size: 0.95em;
        margin-left: 8px;
        box-shadow: 0 1px 4px #ff9800;
        font-weight: bold;
        letter-spacing: 1px;
    }
</style>